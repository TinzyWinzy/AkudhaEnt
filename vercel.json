{
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "framework": "vite",
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "akudha.vercel.app" }], "destination": "https://akudhaent.nexusagronomics.co.zw/$1", "permanent": true }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
