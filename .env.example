# Local development defaults. Replace every production secret in the hosting dashboard.
NODE_ENV=development
PORT=3001
USE_DATABASE=false
MONGODB_URI=mongodb://127.0.0.1:27017/akudha
MONGODB_DB=akudha
JWT_SECRET=replace-with-at-least-32-random-characters
REFRESH_SECRET=replace-with-a-different-32-character-secret
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
BOOTSTRAP_ADMIN_EMAIL=admin@akudha.co.zw
BOOTSTRAP_ADMIN_STAFF_ID=AKU-ADMIN
BOOTSTRAP_ADMIN_PIN=replace-with-a-random-6-digit-pin

# Leave blank when the frontend and API share one origin.
VITE_API_BASE_URL=

# Optional AI enrichment. Rules-based decisions work without this key.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
