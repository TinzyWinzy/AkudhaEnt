{
  "name": "akudha",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:server": "tsx watch server/index.ts",
    "dev:all": "node -e \"const{spawn}=require('child_process');spawn('npx',['vite','--port=3000','--host=0.0.0.0'],{stdio:'inherit',shell:true});spawn('npx',['tsx','watch','server/index.ts'],{stdio:'inherit',shell:true});\"",
    "build": "vite build",
    "preview": "vite preview",
    "server": "tsx server/index.ts",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify:db": "tsx scripts/verify-mongodb.ts",
    "migrate:gtin-index": "tsx scripts/migrate-gtin-index.ts",
    "seed:label-templates": "tsx scripts/seed-label-templates.ts",
    "backup:db": "tsx scripts/backup-mongodb.ts",
    "restore:db": "tsx scripts/restore-mongodb.ts",
    "clean": "rimraf dist",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vercel/functions": "^3.9.9",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "idb": "^8.0.3",
    "jose": "^6.2.12",
    "jsbarcode": "^3.12.3",
    "lucide-react": "^0.546.0",
    "mongoose": "^9.7.2",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^4.1.9"
  }
